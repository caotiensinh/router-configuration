  "observations": [
    {
      "id": "switch-interface-operational-state",
      "module": "Cisco-IOS-XE-interfaces-oper",
      "xpath": "/interfaces-ios-xe-oper:interfaces/interface",
      "required_module_advertisement": true,
      "required_fields": ["name", "admin-status", "oper-status"],
      "source": "https://www.cisco.com/c/en/us/products/collateral/switches/catalyst-9300-series-switches/model-driven-telemetry-wp.html"
    },
    {
      "id": "switch-vlan-operational-state",
      "module": "Cisco-IOS-XE-vlan-oper",
      "xpath": "/vlan-ios-xe-oper:vlans/vlan",
      "required_module_advertisement": true,
      "required_fields": ["id", "status"],
      "normalized_optional_fields": ["name", "ports", "vlan-interfaces"]
    },
    {
      "id": "switch-mac-operational-state",
      "module": "Cisco-IOS-XE-matm-oper",
      "xpath": "/matm-ios-xe-oper:matm-oper-data",
      "required_module_advertisement": true,
      "bounded_table_type": "mat-vlan",
      "required_fields": ["table-type", "vlan-id-number", "mac", "mat-addr-type"],
      "normalized_optional_fields": ["port", "vlan-all"],
      "source": "https://www.cisco.com/c/en/us/products/collateral/switches/catalyst-9300-series-switches/model-driven-telemetry-wp.html"
    },
    {
      "id": "switch-stp-operational-state",
      "module": "Cisco-IOS-XE-spanning-tree-oper",
      "xpath": "/stp-ios-xe-oper:stp-details/stp-detail",
      "required_module_advertisement": true,
      "required_fields": ["instance"],
      "normalized_optional_fields": ["bridge-priority", "bridge-address", "designated-root-priority", "designated-root-address", "root-port", "root-cost", "topology-changes", "interfaces"]
    },
    {
      "id": "switch-trunk-operational-state",
      "module": "openconfig-vlan",
      "schema_path": "/oc-if:interfaces/oc-if:interface/oc-eth:ethernet/oc-vlan:switched-vlan/oc-vlan:state",
      "list_key": "oc-if:name",
      "required_module_advertisement": true,
      "required_modules": [
        "openconfig-interfaces",
        "openconfig-if-ethernet",
        "openconfig-vlan",
        "openconfig-vlan-types"
      ],
      "required_fields": ["interface", "interface-mode"],
      "normalized_optional_fields": ["native-vlan", "access-vlan", "trunk-vlans"],
      "interface_mode_enum": ["ACCESS", "TRUNK"],
      "vlan_id_range": "1..4094",
      "trunk_vlan_range_syntax": "x..y inclusive, with x < y",
      "absence_semantics": "When trunk-vlans is absent on a TRUNK interface, the OpenConfig model states that all VLANs are allowed.",
      "sources": {
        "17.18.1_tree": "https://github.com/CiscoDevNet/cisco-ios-xe-openapi-swagger/blob/a4a7b5bc090ab178b5fe75c6a6473ca57cbf5891/releases/17.18.1/yang-trees/openconfig-vlan.html",
