    "SSHBackend",
    "HTTPAPIBackend",
    "ControllerBackend",
    "PhysicalDeviceBackend"
  ],
  "required_operations": [
    "discover",
    "snapshot",
    "plan",
    "read_back",
    "verify"
  ],
  "optional_mutating_operations": [
    "apply",
    "rollback"
  ],
  "invariants": {
    "capabilities_are_explicit": true,
    "backend_identity_is_explicit": true,
    "vendor_and_model_scope_are_explicit": true,
    "write_authority_is_separate_from_backend_presence": true,
